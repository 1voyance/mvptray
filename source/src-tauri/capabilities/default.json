{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the tray flyout",
  "windows": [
    "main",
    "flyout",
    "prompt"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "notification:default",
    "dialog:default"
  ]
}