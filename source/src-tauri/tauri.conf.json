{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mihomo Tray",
  "version": "2.4.1",
  "identifier": "local.mihomo.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mihomo VPN",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0b0f1a"
      },
      {
        "label": "flyout",
        "title": "Mihomo",
        "url": "flyout.html",
        "width": 340,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "transparent": true,
        "theme": "Dark",
        "backgroundColor": "#00000000"
      },
      {
        "label": "prompt",
        "title": "Mihomo",
        "url": "prompt.html",
        "width": 380,
        "height": 176,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "transparent": true,
        "theme": "Dark",
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}